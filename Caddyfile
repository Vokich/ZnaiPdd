{$DJANGO_DOMAIN:xn--80aiajlwq.xn--p1ai} {
	encode zstd gzip

	handle_path /media/* {
		root * /srv/media
		header X-Content-Type-Options nosniff
		file_server
	}

	@django path /api /api/* /admin /admin/* /static/* /certificate/* /download-training/ /municipalities/search/
	handle @django {
		reverse_proxy web:8000
	}

	handle /assets/* {
		root * /srv/frontend
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /art/* {
		root * /srv/frontend
		file_server
	}

	handle {
		root * /srv/frontend
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
